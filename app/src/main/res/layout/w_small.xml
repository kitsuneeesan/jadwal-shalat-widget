<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_glass" android:orientation="vertical" android:padding="16dp" >
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/badge_glass">
<ImageView android:id="@+id/next_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mosque" android:tint="@color/w_accent" android:layout_gravity="center" />
</FrameLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_pin" android:tint="@color/w_muted" />
<TextView android:id="@+id/location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/w_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/w_shadow" android:shadowDy="1" android:shadowRadius="3" android:layout_marginStart="4dp" />
</LinearLayout>
</LinearLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
<TextView android:id="@+id/next_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="14sp" android:textColor="@color/w_accent" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/w_shadow" android:shadowDy="1" android:shadowRadius="3" android:fontFamily="sans-serif-medium" android:text="—" />
<TextView android:id="@+id/next_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="36sp" android:textColor="@color/w_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/w_shadow" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold" android:text="--:--" android:layout_marginTop="2dp" />
<TextView android:id="@+id/next_in" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/w_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/w_shadow" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="4dp" />
<ProgressBar android:id="@+id/progress" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="10dp" android:max="1000" android:progressDrawable="@drawable/progress_glass" />
</LinearLayout>
