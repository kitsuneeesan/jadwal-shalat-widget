<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" >
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_quran" android:tint="@color/w_icon" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="10dp">
<TextView android:id="@+id/q_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/w_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/q_shadow" android:shadowDy="1" android:shadowRadius="3" android:fontFamily="sans-serif-medium" android:text="@string/widget_quran" />
<TextView android:id="@+id/q_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/w_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/q_shadow" android:shadowDy="1" android:shadowRadius="3" android:layout_marginTop="3dp" />
</LinearLayout>
<ImageView android:id="@+id/q_prev" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_left" android:tint="@color/w_icon" android:padding="6dp" />
<ImageView android:id="@+id/q_next" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_right" android:tint="@color/w_icon" android:padding="6dp" android:layout_marginEnd="-6dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:id="@+id/q_body" android:layout_weight="1" android:layout_marginTop="6dp" android:gravity="center_vertical">

</LinearLayout>
<TextView android:id="@+id/q_dots" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/w_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/q_shadow" android:shadowDy="1" android:shadowRadius="3" android:layout_gravity="center_horizontal" android:letterSpacing="0.3" />
</LinearLayout>
