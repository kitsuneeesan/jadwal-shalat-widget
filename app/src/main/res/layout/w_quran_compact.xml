<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="2dp" android:gravity="center_vertical" android:paddingVertical="10dp">
<ImageView android:id="@+id/q_prev" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_left" android:tint="@color/w_icon" android:padding="6dp" />
<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:orientation="vertical" android:layout_weight="1" android:layout_marginHorizontal="6dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:orientation="vertical" android:id="@+id/q_body" android:layout_weight="1" android:gravity="center">

</LinearLayout>
<TextView android:id="@+id/q_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/w_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/q_shadow" android:shadowDy="1" android:shadowRadius="3" android:layout_gravity="center_horizontal" android:layout_marginTop="2dp" />
</LinearLayout>
<ImageView android:id="@+id/q_next" android:layout_width="32dp" android:layout_height="32dp" android:src="@drawable/ic_chevron_right" android:tint="@color/w_icon" android:padding="6dp" />
</LinearLayout>
