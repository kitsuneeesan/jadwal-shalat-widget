<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_glass" android:orientation="horizontal" android:padding="2dp" android:gravity="center_vertical" android:paddingStart="10dp">
<ImageView android:id="@+id/focus_icon" android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mosque" android:tint="@color/w_accent" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="8dp">
<TextView android:id="@+id/focus_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="20sp" android:textColor="@color/w_text" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/w_shadow" android:shadowDy="1" android:shadowRadius="3" android:textStyle="bold" android:text="--:--" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="center_vertical">
<TextView android:id="@+id/focus_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/w_accent" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/w_shadow" android:shadowDy="1" android:shadowRadius="3" android:fontFamily="sans-serif-medium" android:text="—" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/w_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/w_shadow" android:shadowDy="1" android:shadowRadius="3" android:text="·" android:layout_marginHorizontal="4dp" />
<TextView android:id="@+id/focus_in" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="@color/w_muted" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:shadowColor="@color/w_shadow" android:shadowDy="1" android:shadowRadius="3" android:layout_width="0dp" android:layout_weight="1" />
</LinearLayout>
</LinearLayout>
</LinearLayout>
